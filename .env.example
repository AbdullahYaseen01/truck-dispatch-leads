# ---- Required ----
# 32+ random characters. Encrypts SMTP/IMAP passwords and signs unsubscribe links. Never change it after go-live.
APP_SECRET=
# First admin user (created on first start if no users exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public URL of this server, used in unsubscribe links (must be reachable by recipients)
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
# Set to 1 when served over HTTPS
SECURE_COOKIES=0
# DATA_DIR=./data
# WORKER_CONCURRENCY=6

# ---- Free-only mode (default on) ----
# Paid services (Google Places, ZeroBounce, NeverBounce, OpenAI/Anthropic APIs) stay off even if a key is set.
# FREE_ONLY=1

# ---- AI (optional, free) ----
# Without a model the agents use their rule engines and templates; everything still works.
# Free local option: install Ollama (https://ollama.com), run `ollama pull llama3.1:8b`, then:
LLM_BASE_URL=
# LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
# Only needed for a hosted provider's free tier with an OpenAI-compatible endpoint.
LLM_API_KEY=
# Max AI calls per day across all agents (results are cached, so unchanged leads cost nothing)
LLM_DAILY_LIMIT=300

# ---- Discovery sources ----
# FMCSA Operating Authority + Company Census work with no key. A free Socrata app token only raises rate limits.
SOCRATA_APP_TOKEN=
# Optional free tiers:
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
CRAWLER_USER_AGENT=DispatchLeadBot/1.0 (+https://your-site.example/bot)

# ---- Email verification (free) ----
# SMTP RCPT probe: asks the recipient's mail server whether the mailbox exists, without sending mail.
# Needs outbound port 25. Works best from a server whose IP has reverse DNS (PTR) matching SMTP_PROBE_HELO;
# some providers (Outlook, Yahoo) refuse probes from home/cloud IPs, and those addresses stay "likely valid"/"unknown".
# SMTP_PROBE=0 turns it off.
SMTP_PROBE_HELO=your-domain.com
SMTP_PROBE_FROM=verify@your-domain.com

# ---- Webhooks (optional) ----
INBOUND_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SIGNING_KEY=
